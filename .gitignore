# GitHub 업로드 - 최종 AI 배포 폴더만 허용
/*

# 저장소 설정 파일
!/.gitignore
!/.gitattributes

# 팀에 전달할 최종 AI 서버·모델 패키지
!/ai/
!/ai/**

# ai 내부에서도 로컬 환경과 실행 산출물 제외
/ai/.venv/
/ai/**/__pycache__/
/ai/**/*.py[cod]
/ai/.env
/ai/storage/events/*
!/ai/storage/events/.gitkeep

# 로컬 백업 모델은 업로드하지 않음
/ai/model/*_before_*.pt
/ai/model/*_backup.pt
